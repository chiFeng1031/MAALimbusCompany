{
    "interface_version": 2,
    "name": "MAALimbusCompany",
    "description": "基于 MaaFramework 的 LimbusCompany（边狱公司）小助手，支持安卓模拟器与 PC（Steam）。安卓建议分辨率 1280x720；PC 请使用 16:9 窗口。游戏 Render Scaling 设为 Medium 以上，语言设为 English。",
    "github": "https://github.com/chiFeng1031/MAALimbusCompany",
    "version": "v0.0.1",
    "controller": [
        {
            "name": "ADB 默认方式",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "PC 端（前台，兼容性高）",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "^LimbusCompany$",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        },
        {
            "name": "PC 端（后台）",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "^LimbusCompany$",
                "screencap": "FramePool",
                "mouse": "PostMessage",
                "keyboard": "PostMessage"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "经验本（战斗）",
            "entry": "ExpLuxcavation"
        },
        {
            "name": "纺锤本（跳过）",
            "entry": "ThreadLuxcavationSkip"
        },
        {
            "name": "纺锤本（战斗）",
            "entry": "ThreadLuxcavationBattle"
        },
        {
            "name": "合成脑啡肽",
            "entry": "CraftModule"
        },
        {
            "name": "领取日常任务（第三赛季）",
            "entry": "SubmitMission"
        },
        {
            "name": "活动：鸡-11关（活动已结束）",
            "entry": "Mission_4_5_11"
        },
        {
            "name": "活动：鸡-12关（活动已结束）",
            "entry": "Mission_4_5_12"
        },
        {
            "name": "活动：MiracleDistrict-13关（活动已结束）",
            "entry": "Mission_5_5_13"
        },
        {
            "name": "活动：肉斩骨断-22关",
            "entry": "Mission_5_5_22"
        },
        {
            "name": "活动：肉斩骨断-23关",
            "entry": "Mission_5_5_23"
        },
        {
            "name": "活动：时间杀人时间-2关",
            "entry": "Mission_6_5_2"
        },
        {
            "name": "活动：WRAP快车谋杀案-27关",
            "entry": "Mission_6_5_27"
        }
    ]
}
